# Copy to .env (git-ignored). Fake values. The Anthropic key comes from the vault.
ANTHROPIC_API_KEY=
HOME_AGENTS_SERVICE_TOKEN=
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
DAILY_SPEND_ALERT_CAD=5
MONTHLY_SPEND_CAP_CAD=70
REQUEST_TOKEN_BUDGET=60000
# Live view and take over (S1.6.1): the signing key shared with the screen relay (`openssl rand -hex 32`)
# and the relay's tailnet address on the workspace host, wss://<workspace-host>.<tailnet>.ts.net:8710
HOME_AGENTS_SCREEN_KEY=
SCREEN_RELAY_URL=
# Phase 2: the local model server on the Studio
LOCAL_LLM_URL=
# Harness long-term memory (E1.12). Any long random string; the DSN uses the same one.
MEMORY_DB_PASSWORD=
HOME_AGENTS_PG_DSN=postgresql://harness:<same-password>@memory-db:5432/harness
