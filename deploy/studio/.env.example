# Copy to .env on the Studio (git-ignored). Same keys as deploy/hub/.env.example, plus:
LIVEKIT_KEYS="example-key: example-secret-change-me"
# Harness providers (E1.12): set only the ones you use. Local models need no key.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
HOOK_UPTIME_SECRET=
SEARXNG_SECRET=
MEMORY_DB_PASSWORD=
HOME_AGENTS_PG_DSN=postgresql://harness:<same-password>@memory-db:5432/harness
